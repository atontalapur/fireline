# Copy to .env (gitignored) and fill in. Never commit real values.

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform
# Browser key: HTTP referrer restricted, Maps JavaScript API + Places API (New)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: API restricted to Geocoding API
GOOGLE_MAPS_SERVER_KEY=

# Cloud Storage bucket name, without gs://
DATA_BUCKET=

# NASA FIRMS, https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Meteomatics weather API
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Optional: local data cache for the pipeline (default <repo>/data)
FIRELINE_DATA_DIR=
